{
  "name": "best-i18n",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.34.5",
  "description": "Compile-time i18n: translations inlined at the call site, per-locale builds collapse to plain strings, PO-based workflow",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "license": "MIT",
  "homepage": "https://github.com/Debbl/best-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/best-i18n.git",
    "directory": "packages/best-i18n"
  },
  "bugs": "https://github.com/Debbl/best-i18n/issues",
  "keywords": [
    "i18n",
    "internationalization",
    "macro",
    "compile-time",
    "vite-plugin",
    "next",
    "nextjs",
    "gettext",
    "po",
    "react",
    "tree-shaking"
  ],
  "exports": {
    "./macro": {
      "types": "./dist/macro.d.mts",
      "default": "./dist/macro.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./react/macro": {
      "types": "./dist/react-macro.d.mts",
      "default": "./dist/react-macro.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./request": {
      "types": "./dist/request.d.mts",
      "default": "./dist/request.mjs"
    },
    "./locale-url": {
      "types": "./dist/locale-url.d.mts",
      "default": "./dist/locale-url.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "default": "./dist/rolldown.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "default": "./dist/next.mjs"
    },
    "./next/config": {
      "types": "./dist/next-config.d.mts",
      "default": "./dist/next-config.mjs"
    },
    "./next/loader": {
      "types": "./dist/next-loader.d.mts",
      "default": "./dist/next-loader.mjs"
    },
    "./next/navigation": {
      "types": "./dist/next-navigation.d.mts",
      "default": "./dist/next-navigation.mjs"
    },
    "./next/proxy": {
      "types": "./dist/next-proxy.d.mts",
      "default": "./dist/next-proxy.mjs"
    },
    "./next/server": {
      "types": "./dist/next-server.d.mts",
      "default": "./dist/next-server.mjs"
    },
    "./transform": {
      "types": "./dist/transform.d.mts",
      "default": "./dist/transform.mjs"
    },
    "./po": {
      "types": "./dist/po.d.mts",
      "default": "./dist/po.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "i18n-extract": "./dist/cli-extract.mjs",
    "i18n-compile": "./dist/cli-compile.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "release": "bumpp",
    "typecheck": "tsc --noEmit",
    "spike": "node ./spike/run.mjs"
  },
  "peerDependencies": {
    "next": ">=15.2",
    "react": ">=18",
    "rolldown": ">=1",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "gettext-parser": "^9.1.1",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.144.0"
  },
  "devDependencies": {
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "bumpp": "^12.2.1",
    "next": "^16.3.3",
    "react": "^19.2.0",
    "rolldown": "^1.2.6",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
