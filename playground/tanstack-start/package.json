{
  "name": "playground-tanstack-start",
  "version": "0.0.0",
  "private": true,
  "description": "TanStack Start playground for best-i18n, on the plain Vite plugin",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:zh": "I18N_STATIC_LOCALE=zh vite build",
    "start": "node .output/server/index.mjs",
    "extract": "i18n-extract --locales en,zh --src src --messages messages",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "best-i18n": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
