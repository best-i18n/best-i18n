{
  "name": "playground-solid-start",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:zh": "I18N_STATIC_LOCALE=zh vite build",
    "start": "node .output/server/index.mjs",
    "extract": "i18n-extract --locales en,zh --src src --messages messages",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/integration.test.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "best-i18n": "workspace:*",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "nitro": "^3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
