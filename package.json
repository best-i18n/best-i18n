{
  "name": "best-i18n-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for best-i18n: the compile-time i18n toolchain and its playgrounds",
  "homepage": "https://github.com/best-i18n/best-i18n#readme",
  "bugs": "https://github.com/best-i18n/best-i18n/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/best-i18n/best-i18n.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter best-i18n build",
    "test": "pnpm --filter best-i18n test",
    "spike": "pnpm --filter best-i18n spike",
    "bench": "node ./scripts/bench-size.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "pnpm --filter best-i18n release",
    "dev:website": "pnpm --filter @apps/website dev",
    "build:website": "pnpm --filter @apps/website build",
    "dev:next": "pnpm --filter playground-nextjs dev",
    "build:next": "pnpm --filter playground-nextjs build",
    "dev:intl": "pnpm --filter playground-nextjs-intl dev",
    "build:intl": "pnpm --filter playground-nextjs-intl build",
    "dev:tanstack": "pnpm --filter playground-tanstack-start dev",
    "build:tanstack": "pnpm --filter playground-tanstack-start build",
    "dev:paraglide": "pnpm --filter playground-tanstack-start-paraglide dev"
  },
  "devDependencies": {
    "@debbl/oxc-config": "^0.0.3",
    "@types/node": "^25.9.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4"
}
