{
  "name": "best-i18n-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for best-i18n: the compile-time i18n toolchain and its playgrounds",
  "homepage": "https://github.com/best-i18n/best-i18n#readme",
  "bugs": "https://github.com/best-i18n/best-i18n/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/best-i18n/best-i18n.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "spike": "pnpm --filter best-i18n spike",
    "bench": "node ./scripts/bench-size.mjs",
    "play": "node ./scripts/play.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "bumpp packages/*/package.json",
    "dev:website": "pnpm --filter @apps/website dev",
    "build:website": "pnpm --filter @apps/website build",
    "test:solid-start": "pnpm build && pnpm play solid-start test"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@debbl/oxc-config": "^0.0.5",
    "@types/node": "^25.9.6",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4"
}
